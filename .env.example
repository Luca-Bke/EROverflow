# The active LLM provider is chosen by LLM_PROVIDER in
# src/agents/configuration/config.py (NOT via this file). Only the selected
# provider's API key is required; the others can stay as placeholders.

# OpenRouter Configuration
OPENROUTER_API_KEY=...

# L3S GPT-OSS-120B Api
LLMHUB_HOST=https://brrr.kbs.uni-hannover.de/v1
LLMHUB_APIKEY=...

# AcademicCloud Configuration
ACADEMICCLOUD_API_KEY=...
ACADEMICCLOUD_ENDPOINT=https://chat-ai.academiccloud.de/v1
ACADEMICCLOUD_MODEL=qwen3.6-35b-a3b

# LangSmith Configuration (optional but recommended for tracing)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT="EROverflow-terminal-bench"

# Terminal Bench Agent Configuration
ENABLE_RATE_LIMIT_BACKOFF=true  # tries exponential backoff strategy upon API rate limit error
BACKOFF_MAX_RETRIES=4
BACKOFF_BASE_DELAY=5.0

# Logging verbosity: INFO shows the routine decision-trace; WARNING quiets it to
# anomalies/errors only; DEBUG is most verbose.
LOG_LEVEL=INFO

